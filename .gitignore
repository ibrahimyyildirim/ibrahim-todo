# Allowlist: only the app itself is published to GitHub Pages.
# Everything else stays local (kurtarma.html holds recovered personal notes and must never be pushed).
*
!.gitignore
!.nojekyll
!index.html
!manifest.webmanifest
!sw.js
!icons/
!icons/*.png
# notification service source only; its private key (.vapid-private.json) and wrangler state stay local
!push-worker/
!push-worker/worker.js
!push-worker/wrangler.toml
